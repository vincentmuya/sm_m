<FilteredVendorsScreen>:
    name: 'filtered_vendors'
    BoxLayout:
        orientation: 'vertical'

        Widget:
            size_hint: 1, None
            height: 140  # Spacer

        Label:
            id: filter_info_label  # ✅ Ensure this ID is present
            text: "You are viewing filtered vendors:"
            size_hint_y: None
            height: 40
            font_size: "16sp"
            bold: True
            color: 0, 0, 0, 1

        Widget:
            size_hint: 1, None
            height: 10  # Spacer

        ScrollView:
            size_hint: 1, 0.9
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height

                GridLayout:
                    id: vendors_layout
                    cols: 1
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: '10dp'
