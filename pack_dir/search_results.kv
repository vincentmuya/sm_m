<SearchResultsScreen>:
    name: 'vendors'
    BoxLayout:
        orientation: 'vertical'

        ScrollView:
            size_hint: 1, 0.9
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height

                GridLayout:
                    id: vendors_layout
                    cols: 1
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: '10dp'