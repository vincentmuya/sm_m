<SearchResultsScreen>:
    name: 'vendors'
    BoxLayout:
        orientation: 'vertical'

        Widget:  # Spacer to move search label down
            size_hint: 1, None
            height: 140

        Label:
            id: search_label
            text: "Showing Search Results for: "
            size_hint: 1, None
            height: 40
            font_size: "18sp"
            bold: True
            color: 0, 0, 0, 1

        ScrollView:
            size_hint: 1, 0.9
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height

                GridLayout:
                    id: vendors_layout
                    cols: 1
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: '10dp'