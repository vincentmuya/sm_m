<VendorsByServiceScreen>:
    name: 'vendors_by_service'
    BoxLayout:
        orientation: 'vertical'

        # Header for Parent Service Name
        BoxLayout:
            size_hint_y: None
            height: '50dp'  # Adjust height for your header
            padding: [10, 10, 10, 10]  # Optional padding for spacing
            canvas.before:
                Color:
                    rgba: 0.2, 0.4, 0.6, 1  # Background color of the header
                Rectangle:
                    pos: self.pos
                    size: self.size
            Label:
                id: parent_service_name
                text: "Parent Service Name"  # Will be updated dynamically
                font_size: '20sp'
                color: 1, 1, 1, 1  # White text color

        # Content Layout for Vendors
        ScrollView:
            size_hint: 1, 0.9  # Takes 90% of the screen height
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height

                # Vendors will be added dynamically here
                GridLayout:
                    id: vendors_layout
                    cols: 1
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: '10dp'

                    # Each vendor card will be added here dynamically in Python
